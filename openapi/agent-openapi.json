  "info": {
    "title": "Quant Server API",
    "description": "量化交易后端接口文档",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "AgentRunEventsDto": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "afterSequence": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "runId",
          "afterSequence"
        ]
      },
      "AgentToolCallListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentToolCallResponseDto"
            }
          },
          "payloadIncluded": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "items",
          "payloadIncluded"
        ]
      },
      "AgentToolCallResponseDto": {
        "type": "object",
        "properties": {
          "toolCallId": {
            "type": "string"
          },
          "toolName": {
            "type": "string"
          },
          "toolVersion": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "AUTHORIZING",
              "RUNNING",
              "RETRY_WAIT",
              "SUCCEEDED",
              "FAILED",
              "CANCELLED",
              "REJECTED"
            ]
          },
          "attemptCount": {
            "type": "number"
          },
          "inputSummary": {
            "type": "object",
            "additionalProperties": true
          },
          "outputSummary": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "errorCode": {
            "type": "number",
            "nullable": true
          },
          "errorMessage": {
            "type": "string",
            "nullable": true
          },
          "durationMs": {
            "type": "number",
            "nullable": true
          },
          "dataAsOf": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "dataThrough": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "toolCallId",
          "toolName",
          "toolVersion",
          "status",
          "attemptCount",
          "inputSummary",
          "startedAt"
        ]
      },
      "ResponseModel": {
        "type": "object",
        "properties": {
          "code": {
            "type": "number",
            "default": 0
          },
          "message": {
            "type": "string",
            "default": ""
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ListAgentToolCallsDto": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "includePayload": {
            "type": "boolean",
            "default": false,
            "description": "普通用户端点始终只返回脱敏摘要"
          }
        },
        "required": [
          "runId"
        ]
      },
      "CancelAgentRunResponseDto": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "CANCEL_REQUESTED",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "statusVersion": {
            "type": "number"
          },
          "cancellationAccepted": {
            "type": "boolean"
          }
        },
        "required": [
          "runId",
          "status",
          "statusVersion",
          "cancellationAccepted"
        ]
      },
      "CancelAgentRunDto": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "expectedStatusVersion": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "runId",
          "expectedStatusVersion"
        ]
      },
      "AgentRunStatusResponseDto": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "conversationId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "CANCEL_REQUESTED",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "statusVersion": {
            "type": "number"
          },
          "currentStep": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/AgentRunCurrentStepDto"
              }
            ]
          },
          "finalMessageId": {
            "type": "string",
            "nullable": true
          },
          "latestEventSequence": {
            "type": "number"
          },
          "canCancel": {
            "type": "boolean"
          },
          "errorCode": {
            "type": "number",
            "nullable": true
          },
          "errorMessage": {
            "type": "string",
            "nullable": true
          },
          "queuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "endedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "runId",
          "conversationId",
          "status",
          "statusVersion",
          "latestEventSequence",
          "canCancel",
          "queuedAt"
        ]
      },
      "AgentRunCurrentStepDto": {
        "type": "object",
        "properties": {
          "stepId": {
            "type": "string"
          },
          "stepKey": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "PLAN",
              "TOOL",
              "MODEL",
              "VALIDATION",
              "WAIT",
              "FINALIZE"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "RUNNING",
              "COMPLETED",
              "FAILED",
              "CANCELLED",
              "SKIPPED"
            ]
          },
          "ordinal": {
            "type": "number"
          }
        },
        "required": [
          "stepId",
          "stepKey",
          "kind",
          "status",
          "ordinal"
        ]
      },
      "AgentRunStatusDto": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          }
        },
        "required": [
          "runId"
        ]
      },
      "AgentRunRegeneratedResponseDto": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string"
          },
          "sourceMessageId": {
            "type": "string"
          },
          "assistantMessageId": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "runStatus": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "CANCEL_REQUESTED",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "streamEndpoint": {
            "type": "string",
            "enum": [
              "/api/agent/runs/events"
            ]
          }
        },
        "required": [
          "conversationId",
          "sourceMessageId",
          "assistantMessageId",
          "runId",
          "runStatus",
          "streamEndpoint"
        ]
      },
      "RegenerateAgentMessageDto": {
        "type": "object",
        "properties": {
          "clientRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "messageId": {
            "type": "string"
          },
          "modelPolicy": {
            "type": "string",
            "enum": [
              "AUTO",
              "MANUAL"
            ]
          }
        },
        "required": [
          "clientRequestId",
          "messageId",
          "modelPolicy"
        ]
      },
      "AgentRunCreatedResponseDto": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string"
          },
          "userMessageId": {
            "type": "string"
          },
          "assistantMessageId": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "runStatus": {
            "type": "string",
            "enum": [
              "QUEUED",
              "RUNNING",
              "CANCEL_REQUESTED",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "streamEndpoint": {
            "type": "string",
            "enum": [
              "/api/agent/runs/events"
            ]
          }
        },
        "required": [
          "conversationId",
          "userMessageId",
          "assistantMessageId",
          "runId",
          "runStatus",
          "streamEndpoint"
        ]
      },
      "SendAgentMessageDto": {
        "type": "object",
        "properties": {
          "clientRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "conversationId": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "maxLength": 10000
          },
          "pageContext": {
            "$ref": "#/components/schemas/AgentPageContextDto"
          },
          "modelPolicy": {
            "type": "string",
            "enum": [
              "AUTO",
              "MANUAL"
            ]
          },
          "allowedCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "INTERNAL_DATA",
                "QUANT_COMPUTE",
                "WEB_SEARCH"
              ]
            }
          }
        },
        "required": [
          "clientRequestId",
          "conversationId",
          "content",
          "modelPolicy",
          "allowedCapabilities"
        ]
      },
      "AgentPageContextDto": {
        "type": "object",
        "properties": {
          "route": {
            "type": "string",
            "example": "/stock/detail"
          },
          "entityType": {
            "type": "string",
            "enum": [
              "STOCK",
              "INDEX",
              "PORTFOLIO",
              "BACKTEST",
              "REPORT"
            ]
          },
          "entityId": {
            "type": "string",
            "example": "600519.SH"
          },
          "selectedRange": {
            "$ref": "#/components/schemas/AgentPageRangeDto"
          },
          "visibleDataAsOf": {
            "type": "string",
            "example": "2026-07-17"
          }
        },
        "required": [
          "route"
        ]
      },
      "AgentPageRangeDto": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "example": "2021-01-01"
          },
          "end": {
            "type": "string",
            "example": "2026-07-17"
          }
        },
        "required": [
          "start",
          "end"
        ]
      },
      "UpdateConversationModelResponseDto": {
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string"
          },
          "modelPolicy": {
            "type": "string",
            "enum": [
              "AUTO",
              "MANUAL"
            ]
          },
          "preferredModel": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "conversationId",
          "modelPolicy",
          "updatedAt"
        ]
      },
      "UpdateConversationModelDto": {
