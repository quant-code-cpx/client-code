    "/agent/runs/events": {
      "post": {
        "operationId": "AgentStreamController_events",
        "parameters": [
          {
            "name": "last-event-id",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Last-Event-ID",
            "in": "header",
            "description": "同一 Run 内最后确认的持久 eventId",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRunEventsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "raw text/event-stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "example": "id: evt_xxx\nevent: agent.progress\ndata: {...}\n\n"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "重放并持续订阅 Agent Run 持久事件",
        "tags": [
          "Agent - 事件流"
        ]
      }
    }
