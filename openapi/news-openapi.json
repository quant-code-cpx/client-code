              "schema": {
                "$ref": "#/components/schemas/NewsArticleDetailRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ResponseModel"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/NewsArticleDetailResponseDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
