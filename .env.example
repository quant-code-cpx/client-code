# API 服务地址（后端 NestJS 地址）
VITE_API_URL=http://localhost:3000
# 旧部署兼容；新环境优先使用 VITE_API_URL
VITE_API_BASE_URL=http://localhost:3000

# Agent SSE 恢复预算与心跳超时（非敏感配置）
VITE_AGENT_ENABLED=false
VITE_AGENT_STREAM_MAX_RETRIES=3
VITE_AGENT_STREAM_STALE_MS=30000

# WebSocket 服务地址（用于回测进度推送、同步状态等实时通知）
VITE_WS_URL=ws://localhost:3000
