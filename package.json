{
  "name": "@minimal/material-kit-react",
  "author": "minimals.cc",
  "licence": "MIT",
  "version": "3.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite preview",
    "build": "tsc && vite build",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:print": "npx eslint --print-config eslint.config.mjs > eslint-show-config.json",
    "fm:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "fm:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "fix:all": "npm run lint:fix && npm run fm:fix",
    "clean": "rm -rf node_modules .next out dist build",
    "re:dev": "yarn clean && yarn install && yarn dev",
    "re:build": "yarn clean && yarn install && yarn build",
    "tsc:dev": "yarn dev & yarn tsc:watch",
    "tsc:watch": "tsc --noEmit --watch",
    "tsc:print": "npx tsc --showConfig",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "api:agent:generate": "node scripts/generate-agent-api.mjs",
    "api:agent:check": "node scripts/generate-agent-api.mjs --check",
    "api:news:generate": "node scripts/generate-news-api.mjs",
    "api:news:check": "node scripts/generate-news-api.mjs --check",
    "test:agent-contracts": "vitest run src/types/agent/__tests__/agent-contracts.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "check:buttons": "node scripts/check-button-rules.mjs",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --project=agent-chromium e2e/agent-chat.e2e.ts",
    "e2e:agent-real": "playwright test --config playwright.agent-real.config.ts",
    "e2e:ui": "playwright test --ui",
    "mock:generate": "node scripts/capture-mock-data.mjs",
    "mock:generate:fetch": "node scripts/capture-mock-data.mjs",
    "demo": "VITE_DEMO_MODE=true vite",
    "demo:build": "VITE_DEMO_MODE=true tsc && VITE_DEMO_MODE=true vite build",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource-variable/dm-sans": "^5.2.5",
    "@fontsource/barlow": "^5.2.5",
    "@iconify/react": "^5.2.1",
    "@mui/icons-material": "7.3.10",
    "@mui/lab": "^7.0.0-beta.10",
    "@mui/material": "^7.3.10",
    "@mui/system": "^7.3.10",
    "@mui/x-chat": "9.0.0-alpha.15",
    "@mui/x-date-pickers": "^9.0.0",
    "apexcharts": "^5.10.4",
    "dayjs": "^1.11.13",
    "es-toolkit": "^1.34.1",
    "katex": "^0.18.2",
    "klinecharts": "10.0.1",
    "minimal-shared": "^1.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-virtuoso": "^4.18.7",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "simplebar-react": "^3.3.2",
    "socket.io-client": "4.8.3",
    "stock-sdk": "^1.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@typescript-eslint/parser": "^8.29.0",
    "@vitejs/plugin-react-swc": "^3.8.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.23.0",
    "eslint-import-resolver-typescript": "^4.3.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-perfectionist": "^4.11.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "msw": "^2.13.4",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.29.0",
    "vite": "^6.2.5",
    "vite-plugin-checker": "^0.9.1",
    "vitest": "^3.2.4"
  },
  "resolutions": {
    "engine.io-client": "6.6.6",
    "socket.io-parser": "4.2.7",
    "yaml": "1.10.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
